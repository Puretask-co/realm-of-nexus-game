{
  "name": "realm-of-nexus-game",
  "version": "0.1.0",
  "description": "Realm of Nexus - A 2D tactical RPG built with Phaser.js featuring the Sap Cycle temporal magic system",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && cp -r data dist/data",
    "preview": "vite preview",
    "editor": "EDITOR_MODE=true vite --host",
    "validate-data": "node scripts/validate-data.js",
    "export-csv": "node scripts/export-csv.js",
    "gen-images": "node --env-file=.env scripts/generate-images.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "sharp": "^0.35.2",
    "vite": "^5.4.21"
  },
  "keywords": [
    "phaser",
    "game",
    "rpg",
    "tactical",
    "2d"
  ],
  "author": "Nathan Chiaratti",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
